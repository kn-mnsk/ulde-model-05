// tsconfig.paths.json  ULDE Alias path map
// shared “base” config among tsconfig.json, tsconfig.app.json and tsconfig.editor.json
{
  "compilerOptions": {
    "paths": {
      "@ulde/configurator": [
        "./src/ulde/configurator/index"
      ],
      "@ulde/configurator/*": [
        "./src/ulde/configurator/*"
      ],
      "@ulde/core": [
        "./src/ulde/core/index"
      ],
      "@ulde/core/*": [
        "./src/ulde/core/*"
      ],
      "@ulde/devtools": [
        "./src/ulde/devtools/index"
      ],
      "@ulde/devtools/*": [
        "./src/ulde/devtools/*"
      ],
      "@ulde/engine": [
        "./src/ulde/engine/index"
      ],
      "@ulde/engine/*": [
        "./src/ulde/engine/*"
      ],
      "@ulde/plugins": [
        "./src/ulde/plugins/index"
      ],
      "@ulde/plugins/*": [
        "./src/ulde/plugins/*"
      ],
      "@ulde/tools": [
        "./src/ulde/tools/index"
      ],
      "@ulde/tools/*": [
        "./src/ulde/tools/*"
      ],
      "@ulde/types": [
        "./src/ulde/types/index"
      ],
      "@ulde/types/*": [
        "./src/ulde/types/*"
      ],
      "@ulde/viewer": [
        "./src/ulde/viewer/index"
      ],
      "@ulde/viewer/*": [
        "./src/ulde/viewer/*"
      ],
    }
  }
}
